ENVIRONMENT=development
PROJECT_NAME=TOFAA CRM
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000
# Optional: allow every Vercel deployment of the frontend (previews get new URLs)
# BACKEND_CORS_ORIGIN_REGEX=https://your-frontend(-[a-z0-9-]+)?\.vercel\.app
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for legacy projects that sign tokens with HS256. Projects using ES256 keys leave it empty.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated
SESSION_IDLE_MINUTES=30
# Off by default: executives use phone and desktop. The app logs out idle sessions itself.
SINGLE_SESSION=false

# Self sign-up (POST /api/v1/auth/signup). People pick a role; admin is never allowed.
SIGNUP_ENABLED=true
# true = new accounts wait for an admin to activate them in Users
SIGNUP_REQUIRES_APPROVAL=true
# comma separated company domains, e.g. tofaa.in,tofaa.com (empty = any)
SIGNUP_ALLOWED_DOMAINS=
# roles that can be picked at sign-up (admin is never allowed; roles above sales_executive always need approval)
SIGNUP_ALLOWED_ROLES=sales_executive,sales_manager,finance,kam
# WhatsApp Business Cloud API (Meta). Leave empty to use click-to-chat until approval.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_COST_PER_CONVERSATION=0.8
# Quotation on WhatsApp with a "View quotation" button. Outside the 24-hour window Meta needs this approved template
# (category Utility). Body:
#   Hello {{1}},
#
#   Thank you for your interest in Tofaa India. Your quotation {{2}} for {{3}} is ready.
#   Total: {{4}}
#
#   Tap the button below to view or download it.
# Button: "Visit website", text "View quotation", URL type Dynamic: https://<your CRM address>/s/{{1}}
# FRONTEND_URL must be that same public https address. Empty template = click-to-chat with a link instead.
WHATSAPP_QUOTATION_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Phase 2
COMPANY_NAME=Tofaa India
COMPANY_ADDRESS=
# Quotation letterhead footer (these defaults are used when left out)
# COMPANY_PHONE=+91 9511870124
# COMPANY_EMAIL=indiatofaa@gmail.com
# COMPANY_WEBSITE=www.tofaaindia.com
# COMPANY_GSTIN=27AIEPC1532D2ZY
# COMPANY_POWERED_BY=SIDDHI GROUP OF COMPANIES
# The ERP signs payment callbacks with this secret (HMAC SHA-256). Empty = callbacks are refused.
ERP_WEBHOOK_SECRET=
# Finance "Confirm payment" button. Set false once the ERP integration is live.
PAYMENT_FALLBACK_ENABLED=true
# Client management
CLIENT_TIER_A=1000000
CLIENT_TIER_B=200000
CLIENT_DORMANT_DAYS=180
