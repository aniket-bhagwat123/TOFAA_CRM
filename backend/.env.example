ENVIRONMENT=development
PROJECT_NAME=TOFAA CRM
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for legacy projects that sign tokens with HS256. Projects using ES256 keys leave it empty.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM=HS256
SUPABASE_JWT_AUDIENCE=authenticated
SESSION_IDLE_MINUTES=30
# Off by default: executives use phone and desktop. The app logs out idle sessions itself.
SINGLE_SESSION=false

# Self sign-up (POST /api/v1/auth/signup). People pick a role; admin is never allowed.
SIGNUP_ENABLED=true
# true = new accounts wait for an admin to activate them in Users
SIGNUP_REQUIRES_APPROVAL=true
# comma separated company domains, e.g. tofaa.in,tofaa.com (empty = any)
SIGNUP_ALLOWED_DOMAINS=
# roles that can be picked at sign-up (admin is never allowed; roles above sales_executive always need approval)
SIGNUP_ALLOWED_ROLES=sales_executive,sales_manager,finance,kam
# WhatsApp Business Cloud API (Meta). Leave empty to use click-to-chat until approval.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_COST_PER_CONVERSATION=0.8
# Phase 2
COMPANY_NAME=Tofaa
COMPANY_ADDRESS=
# The ERP signs payment callbacks with this secret (HMAC SHA-256). Empty = callbacks are refused.
ERP_WEBHOOK_SECRET=
# Finance "Confirm payment" button. Set false once the ERP integration is live.
PAYMENT_FALLBACK_ENABLED=true
# Client management
CLIENT_TIER_A=1000000
CLIENT_TIER_B=200000
CLIENT_DORMANT_DAYS=180
